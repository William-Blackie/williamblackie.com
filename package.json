{
    "name": "williambackie.com",
    "author": "William Blackie <will@developerfy.com>",
    "version": "0.1.0",
    "private": true,
    "browserslist": [
        ">0.3%, defaults, fully supports es6-module, maintained node versions"
    ],
    "engines": {
        "node": "^24.0.0"
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint . --max-warnings=0",
        "lint:fix": "eslint . --fix",
        "typecheck": "tsc --noEmit --pretty false",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "pnpm run lint && pnpm run typecheck && pnpm run format:check",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{ts,tsx,js,jsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{css,md,mdx,json}": [
            "prettier --write"
        ]
    },
    "files": [
        "./src/styles/typography.css"
    ],
    "dependencies": {
        "@excalidraw/excalidraw": "^0.18.1",
        "@giscus/react": "^3.1.0",
        "@headlessui/react": "^2.2.10",
        "@mdx-js/loader": "^3.1.1",
        "@mdx-js/react": "^3.1.1",
        "@next/mdx": "^16.2.6",
        "@sentry/nextjs": "^10.53.1",
        "@types/node": "^20.19.41",
        "@types/react": "^19.2.15",
        "@types/react-dom": "^19.2.3",
        "@types/webpack-env": "^1.18.8",
        "autoprefixer": "^10.5.0",
        "browserslist": "^4.28.2",
        "cheerio": "^1.2.0",
        "clsx": "^2.1.1",
        "fast-glob": "^3.3.3",
        "feed": "^4.2.2",
        "framer-motion": "12.40.0",
        "next": "^16.2.6",
        "next-llms-txt": "^1.0.2",
        "next-themes": "^0.4.6",
        "node-addon-api": "8.7.0",
        "node-mailjet": "^6.0.11",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "rehype-pretty-code": "^0.14.3",
        "remark-gfm": "^4.0.1",
        "typescript": "^5.9.3",
        "xml2js": "^0.6.2"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.0",
        "@tailwindcss/typography": "0.5.0-alpha.3",
        "@types/mdx": "2.0.13",
        "@types/postcss-import": "^14.0.3",
        "axe-core": "^4.11.4",
        "eslint": "^9.39.4",
        "eslint-config-next": "^16.2.6",
        "eslint-config-prettier": "^10.1.8",
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "playwright": "^1.60.0",
        "postcss-flexbugs-fixes": "5.0.2",
        "postcss-preset-env": "11.3.0",
        "prettier": "^3.8.3",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "sharp": "^0.34.5",
        "tailwindcss": "^4.3.0"
    },
    "prettier": {
        "trailingComma": "all",
        "tabWidth": 4,
        "semi": false,
        "singleQuote": true,
        "experimentalTernaries": true
    },
    "postcss": {
        "plugins": [
            "@tailwindcss/postcss",
            "postcss-flexbugs-fixes",
            [
                "postcss-preset-env",
                {
                    "autoprefixer": {
                        "flexbox": "no-2009"
                    },
                    "stage": 3,
                    "features": {
                        "custom-properties": false
                    }
                }
            ]
        ]
    }
}
