{
    "name": "williambackie.com",
    "author": "William Blackie <will@developerfy.com>",
    "version": "0.1.0",
    "private": true,
    "browserslist": [
        ">0.3%, defaults, fully supports es6-module, maintained node versions"
    ],
    "engines": {
        "node": "^24.0.0"
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint . --max-warnings=0",
        "lint:fix": "eslint . --fix",
        "typecheck": "tsc --noEmit --pretty false",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "pnpm run lint && pnpm run typecheck && pnpm run format:check",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{ts,tsx,js,jsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{css,md,mdx,json}": [
            "prettier --write"
        ]
    },
    "files": [
        "./src/styles/typography.css"
    ],
    "dependencies": {
        "@excalidraw/excalidraw": "^0.18.1",
        "@giscus/react": "^3.1.0",
        "@mdx-js/loader": "^3.1.1",
        "@mdx-js/react": "^3.1.1",
        "@sentry/nextjs": "^10.66.0",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "clsx": "^2.1.1",
        "fast-glob": "^3.3.3",
        "feed": "^6.0.0",
        "next-themes": "^0.4.6",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "rehype-pretty-code": "^0.14.4",
        "remark-gfm": "^4.0.1"
    },
    "devDependencies": {
        "@mdx-js/typescript-plugin": "0.1.3",
        "@next/mdx": "^16.2.10",
        "@tailwindcss/postcss": "^4.3.3",
        "@tailwindcss/typography": "0.5.20",
        "@types/mdx": "2.0.14",
        "@types/node": "^26.1.1",
        "axe-core": "^4.12.1",
        "eslint": "^9.39.5",
        "eslint-config-next": "^16.2.10",
        "eslint-config-prettier": "^10.1.8",
        "framer-motion": "12.42.2",
        "husky": "^9.1.7",
        "lint-staged": "^17.1.0",
        "next": "^16.2.10",
        "playwright": "^1.61.1",
        "prettier": "^3.9.5",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "sharp": "^0.35.3",
        "tailwindcss": "^4.3.3",
        "typescript": "6.0.3"
    },
    "prettier": {
        "trailingComma": "all",
        "tabWidth": 4,
        "semi": false,
        "singleQuote": true,
        "experimentalTernaries": true
    },
    "postcss": {
        "plugins": {
            "@tailwindcss/postcss": {}
        }
    }
}
